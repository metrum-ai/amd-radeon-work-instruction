# ============================================================
# Manufacturing Work Instruction Generator (WIG) — Environment Template
# Copy to .env and fill in ALL values marked REQUIRED.
# scripts/setup.sh scaffolds this automatically — run it instead
# of editing by hand unless you know what you're doing.
#
# This is the ONLY .env file in the repo — docker compose loads
# it from the project root and shares it with every included
# compose file (ingest/, simulator/, models/, oem_ingest/,
# metrics/, frontend/). Do not create per-directory .env files.
# ============================================================

# ------------------------------------------------------------
# Database  (REQUIRED)
# ------------------------------------------------------------
POSTGRES_PASSWORD=
# Full DSN used by wig-api and wig-mcp-tools; setup.sh builds this
# from POSTGRES_PASSWORD once you set it above.
DATABASE_URL=

# ------------------------------------------------------------
# Object store — RustFS / Milvus  (REQUIRED)
# Backs the Milvus vector store used by the ingest RAG service.
# ------------------------------------------------------------
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ------------------------------------------------------------
# Host cache directories  (REQUIRED — set to your local paths)
# ------------------------------------------------------------
HF_CACHE_DIR=
LEMONADE_LLAMA_DIR=
LEMONADE_RECIPE_DIR=

# ------------------------------------------------------------
# GPU allocation  (REQUIRED — match your host's render node numbering)
# renderD* device names as shown by `ls /dev/dri` / rocm-smi.
# ------------------------------------------------------------
# GPU 0 — Qwen3.5-9B (VLM / translation)
GPU_INFERENCE_DEVICE=renderD129
# GPU 1 — Gemma-4-E2B-it instance 1 + 2 (instruction authoring, shared)
GPU_GEMMA_DEVICE=renderD130
# GPU 2 — Flux via Lemonade instance 1 (illustration generation)
GPU_LEMONADE1_DEVICE=renderD128
# GPU 3 — Flux via Lemonade instance 2 (illustration generation)
GPU_LEMONADE2_DEVICE=renderD131

# ------------------------------------------------------------
# GPU device group GIDs  (auto-detected by setup.sh)
# Control container access to /dev/kfd and /dev/dri.
# ------------------------------------------------------------
VIDEO_GID=44
RENDER_GID=109

# ------------------------------------------------------------
# OpenClaw agent gateway
# ------------------------------------------------------------
# true = wig-api calls wig-mcp-tools directly (validated path).
# false = fall back to the legacy agent-instruction-author/
# agent-illustration/agent-compositor containers.
WIG_USE_OPENCLAW_GATEWAY=true

# Bearer token the openclaw-gateway container requires for its HTTP API
# (REQUIRED). setup.sh auto-generates a strong token if left blank —
# never reuse the old "wig-openclaw-internal" placeholder.
OPENCLAW_GATEWAY_TOKEN=

# API keys for the local Gemma model providers behind openclaw-gateway
# (work_instruction_generator/openclaw/openclaw.json). These servers run
# with no auth, so a placeholder is fine — setup.sh auto-generates a short
# one if left blank.
GEMMA_AUTHOR_API_KEY=
TRANSLATE_GEMMA_API_KEY=

# API key the oem-ingest service sends to the local inference (Qwen) server.
# That server runs with no auth, so a placeholder is fine — setup.sh
# auto-generates a short one if left blank.
INFERENCE_API_KEY=
